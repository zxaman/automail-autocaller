{
  "name": "automail-autocaller",
  "version": "0.1.0",
  "private": true,
  "description": "AutoCall & AutoMail communication workspace",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "api:dev": "npm --workspace apps/api run dev",
    "api:build": "npm --workspace apps/api run build",
    "api:start": "npm --workspace apps/api run start",
    "api:test": "npm --workspace apps/api run test",
    "api:test:watch": "npm --workspace apps/api run test:watch"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
