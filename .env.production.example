# Production environment template.
#
# Copy to .env.production and fill from your secret manager. Never commit the
# filled version. The API refuses to start in production when a required value
# is missing, and names what it needs.
#
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d

NODE_ENV=production

# --- Images ---
IMAGE_TAG=latest
WEB_PORT=8080
APP_VERSION=

# --- Data stores ---
# Managed MongoDB and Redis are recommended. If you use the bundled containers,
# these must match the credentials below.
MONGODB_URI=mongodb+srv://user:password@cluster.example.net/automail_autocaller
REDIS_URL=redis://:password@redis:6379

# Only needed when running the bundled mongodb/redis services.
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=
REDIS_PASSWORD=

# --- Web ---
# Public origin of the SPA. Include native origins if the mobile app ships:
#   https://app.example.com,http://localhost,capacitor://localhost
CORS_ORIGINS=https://app.example.com

# Required in production. Sessions travel over TLS only.
COOKIE_SECURE=true
# Use "none" only if the mobile app calls the API cross-origin; it then also
# requires COOKIE_SECURE=true.
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# Behind nginx or a load balancer, or rate limits attribute every request to
# the proxy and the whole deployment shares one bucket.
TRUST_PROXY=true

# --- Authentication ---
GOOGLE_CLIENT_ID=

# --- Credential encryption ---
# 32-byte key, hex or base64. Rotating it invalidates every stored Gmail App
# Password, so plan rotation with users. Generate with:
#   openssl rand -hex 32
CREDENTIAL_ENCRYPTION_KEY=

# --- Email ---
# redis is required in production; the memory driver loses queued mail on restart.
EMAIL_QUEUE_DRIVER=redis
EMAIL_SEND_INTERVAL_MS=1200
EMAIL_MAX_ATTEMPTS=3

# --- Telephony (optional; all-or-nothing) ---
# Leave every value blank to run AutoMail without calling. If any is set, all
# must be set or the API refuses to start.
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUBDOMAIN=api.in.exotel.com
EXOTEL_CALLER_ID=
DEFAULT_CALLER_ID=
TELEPHONY_WEBHOOK_SECRET=

# --- Observability ---
LOG_LEVEL=info
METRICS_TOKEN=
