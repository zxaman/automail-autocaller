# ---------------------------------------------------------------------------
# AutoCall & AutoMail — environment template
# Copy to .env and fill in real values. NEVER commit a populated .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

MONGODB_URI=mongodb://localhost:27017/automail_autocaller
REDIS_URL=redis://localhost:6379

CORS_ORIGINS=http://localhost:4200
LOG_LEVEL=info
TRUST_PROXY=false

# --- Google sign-in ---------------------------------------------------------
# OAuth 2.0 Web application client ID from Google Cloud Console.
# The client ID is public. No client secret is required for the ID-token flow.
# Leave empty to disable Google sign-in; the API then returns
# GOOGLE_AUTH_NOT_CONFIGURED instead of pretending to authenticate.
GOOGLE_CLIENT_ID=

# --- Session ----------------------------------------------------------------
# Opaque session tokens are stored hashed; only the cookie holds the raw value.
SESSION_TTL_DAYS=7
# Set to true in production (HTTPS only).
COOKIE_SECURE=false
# lax is correct for a same-site SPA. Use none + secure for cross-site clients.
COOKIE_SAME_SITE=lax
# Optional, e.g. .yourdomain.com
COOKIE_DOMAIN=

# --- Gmail sending (AutoMail) -----------------------------------------------
# AES-256-GCM key protecting stored Gmail App Passwords.
# Generate with:  openssl rand -hex 32
# NEVER commit a real key. Rotating it invalidates every stored credential,
# and each user must reconnect their Gmail account.
# Leave empty to disable Gmail connection entirely; the API then returns
# GMAIL_ENCRYPTION_NOT_CONFIGURED rather than storing a credential insecurely.
CREDENTIAL_ENCRYPTION_KEY=

# --- AutoMail queue and attachments -----------------------------------------
# "memory" needs no extra infrastructure but loses queued emails if the process
# restarts and does not coordinate across instances. Use "redis" in production.
EMAIL_QUEUE_DRIVER=memory
REDIS_URL=redis://localhost:6379
# Minimum gap between two sends. Paces delivery inside Gmail's limits.
EMAIL_SEND_INTERVAL_MS=1200
EMAIL_MAX_ATTEMPTS=3
# Attachment bytes live here, never in MongoDB. Swap for S3 in production.
ATTACHMENT_STORAGE_DIR=storage/attachments

# SMTP transport. The Gmail defaults suit production; override only for tests.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_TIMEOUT_MS=15000

# --- Testing ----------------------------------------------------------------
# Optional MongoDB for integration tests. When unset the suite tries localhost,
# then an in-memory server, and skips integration tests if neither is available.
MONGODB_TEST_URI=

# --- Telephony (AutoCall) ---------------------------------------------------
# Provider adapter to use. "exotel" is the India-compliant PSTN-bridging path;
# "twilio" is for international destinations only and CANNOT place domestic
# calls to Indian numbers. See telephony-evaluation.md.
TELEPHONY_PROVIDER=exotel

# Exotel. Obtain from the Exotel dashboard API settings. Never commit real values.
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
# Mumbai cluster: api.in.exotel.com   Singapore cluster: api.exotel.com
EXOTEL_SUBDOMAIN=api.in.exotel.com
# Virtual number (ExoPhone) used as caller ID on both legs, E.164.
EXOTEL_CALLER_ID=

# Shared secret used to verify inbound provider webhooks. An unverified webhook
# endpoint lets anyone forge call outcomes, so this is required in production.
TELEPHONY_WEBHOOK_SECRET=

# Call recording is OFF unless a workspace deliberately enables it, and requires
# a consent announcement plus timestamped consent logging (DPDP Act 2023).
# This flag only permits the feature to be offered; it does not enable it.
CALL_RECORDING_ENABLED=false
# Recordings are deleted when this many days elapse. Indefinite retention is not
# offered: the DPDP Act requires purpose-limited storage.
CALL_RECORDING_RETENTION_DAYS=90
