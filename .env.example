# ---------------------------------------------------------------------------
# AutoCall & AutoMail — environment template
# Copy to .env and fill in real values. NEVER commit a populated .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

MONGODB_URI=mongodb://localhost:27017/automail_autocaller
REDIS_URL=redis://localhost:6379

CORS_ORIGINS=http://localhost:4200
LOG_LEVEL=info
TRUST_PROXY=false

# --- Google sign-in ---------------------------------------------------------
# OAuth 2.0 Web application client ID from Google Cloud Console.
# The client ID is public. No client secret is required for the ID-token flow.
# Leave empty to disable Google sign-in; the API then returns
# GOOGLE_AUTH_NOT_CONFIGURED instead of pretending to authenticate.
GOOGLE_CLIENT_ID=

# --- Session ----------------------------------------------------------------
# Opaque session tokens are stored hashed; only the cookie holds the raw value.
SESSION_TTL_DAYS=7
# Set to true in production (HTTPS only).
COOKIE_SECURE=false
# lax is correct for a same-site SPA. Use none + secure for cross-site clients.
COOKIE_SAME_SITE=lax
# Optional, e.g. .yourdomain.com
COOKIE_DOMAIN=

# --- Testing ----------------------------------------------------------------
# Optional MongoDB for integration tests. When unset the suite tries localhost,
# then an in-memory server, and skips integration tests if neither is available.
MONGODB_TEST_URI=
